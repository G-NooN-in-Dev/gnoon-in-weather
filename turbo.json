{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalEnv": [
		"WEATHER_API_BASE_URL",
		"WEATHER_API_KEY",
		"KAKAO_REST_API_KEY",
		"NEXT_PUBLIC_KAKAO_JS_KEY",
		"KAKAO_LOCAL_API_BASE_URL",
		"NAVER_CLIENT_ID",
		"NAVER_CLIENT_SECRET",
		"NAVER_API_BASE_URL"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "storybook-static/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		}
	}
}
