		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"prettier-plugin-tailwindcss-canonical-classes": "^0.1.5",
		"tailwindcss": "^4.3.1",
		"turbo": "^2.9.6",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=18"
	},
	"pnpm": {
		"overrides": {
			"resolve": "^1.22.11"
		}
	},
	"dependencies": {
		"axios": "^1.15.1",
		"zod": "^4.3.6"
